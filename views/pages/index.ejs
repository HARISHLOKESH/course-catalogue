
<%- include('../partials/head') %>

<%- include('../partials/header') %>

<main class="hero">

    <h1>Welcome to SkillUp Academy</h1>

    <p>
        Upgrade your skills and build your future
        with our professional training courses.
    </p>

    <a href="/courses" class="btn">
        Explore Courses
